# Copy this file to .env and fill in your own values.

# Port the API listens on
PORT=5000

# MongoDB connection string
#  - Local MongoDB:  mongodb://127.0.0.1:27017/bamboo_chick
#  - MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bamboo_chick
MONGO_URI=mongodb://127.0.0.1:27017/bamboo_chick

# Secret used to sign login tokens — change this to a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS). Vite dev server runs on 5173.
CLIENT_URL=http://localhost:5173
